APP_NAME="Search App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://contoh.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306                  # local Docker dev: 13306
DB_DATABASE=search_app
DB_USERNAME=search_app
DB_PASSWORD=GANTI_PASSWORD_INI

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Recording searches and clicks runs through the queue. This defaults to
# `sync` (inline) on purpose: with `database` and no running worker, every
# click and search is silently swallowed into the jobs table and the reports
# stay empty with nothing to indicate why.
# Switch to `database` ONLY together with a running `php artisan queue:work`
# - see docs/DEPLOY.md for the systemd unit.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Search app ---------------------------------------------------------
# Flip to true to switch on the ranked results page (see config/search.php).
# All feature flags default to off. See docs/DEPLOY.md.
# Default behaviour: exact keyword matches only. A query that is not in the
# keyword list is NOT redirected anywhere and shows no similar results.
SEARCH_RESULTS_PAGE=false
SEARCH_TIER_PREFIX=false
SEARCH_TIER_FULLTEXT=false
SEARCH_SUGGEST=false
SEARCH_CATALOG_PREVIEW=false
SEARCH_RECENT=false
ADMIN_PANEL_PATH=panel

# Comma-separated hostnames an admin may never point a link at.
SEARCH_BLOCKED_HOSTS=
# Fill this to run the catalog in strict allowlist mode (empty = allow all).
SEARCH_ALLOWED_HOSTS=

SEARCH_CACHE_TTL=600
SEARCH_LOG_RETENTION_DAYS=90
